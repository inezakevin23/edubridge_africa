SECRET_KEY=your_secret_key_here
DEBUG=True

DB_NAME=edubridge_db
DB_USER=edubridge_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

ALLOWED_HOSTS=127.0.0.1,localhost

CORS_ALLOWED_ORIGINS=http://localhost:5173

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key

# S3-Compatible Storage Settings (for django-storages)
SUPABASE_ACCESS_KEY_ID=your_supabase_anon_key
SUPABASE_SECRET_ACCESS_KEY=your_supabase_anon_key
SUPABASE_BUCKET_NAME=edubridge_media_bucket
SUPABASE_S3_ENDPOINT=https://your-project.supabase.co/storage/v1/s3
SUPABASE_PROJECT_REF=your_project_ref
